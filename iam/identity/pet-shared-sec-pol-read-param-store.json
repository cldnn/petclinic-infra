{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowParameterStoreRead",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters",
                "ssm:GetParametersByPath",
                "ssm:ListTagsForResource"
            ],
            "Resource": "arn:aws:ssm:ap-northeast-2:*:*"
        },
        {
            "Sid": "AllowParameterStoreDescribe",
            "Effect": "Allow",
            "Action": "ssm:DescribeParameters",
            "Resource": "*"
        }
    ]
}
