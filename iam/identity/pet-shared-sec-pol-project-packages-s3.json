{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowGetProjectPackages",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::pet-prod-packages-s3/tools/*"
        },
        {
            "Sid": "AllowListProjectPackagesBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::pet-prod-packages-s3"
        }
    ]
}